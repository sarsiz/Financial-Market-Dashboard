# ── Local/private financial data ─────────────────────────────────────────────
# Keep the directory structure through .gitkeep files, but never commit local
# market data, personal watchlists, caches, generated notes, job manifests, DBs,
# provider captures, or research/vault content.
data/**
!data/**/
!data/**/.gitkeep

kb/**
!kb/**/
!kb/**/.gitkeep

vault/market-map/**
!vault/market-map/**/
!vault/market-map/**/.gitkeep

# Any local strategy override config
strategy_config.json
signal_override.json
*.signal.json
*.playbook.json
*.private.json
*.secret.json

# Python / Node local build artifacts
node_modules/.cache/
dist/
*.log
